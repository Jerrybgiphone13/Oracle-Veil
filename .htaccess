# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/oracvufv/heartcut-app"
PassengerBaseURI "/"
PassengerNodejs "/home/oracvufv/nodevenv/heartcut-app/24/bin/node"
PassengerAppType node
PassengerStartupFile server.mjs
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# ^ Generated by cPanel's Node.js Selector and required for /api/* to reach the Passenger
# app in ~/heartcut-app. This file is deployed by `git pull` in public_html, so the block
# must live here: without it LiteSpeed serves /api/interpretation as a static 404.
# To regenerate after a loss:
#   cloudlinux-selector stop  --json --interpreter nodejs --app-root heartcut-app
#   cloudlinux-selector start --json --interpreter nodejs --app-root heartcut-app
# GEMINI_API_KEY is injected by the Node.js Selector's env_vars, not by SetEnv here.
# Oracle Veil — static PWA on Apache / cPanel

Options -Indexes

# Keep one canonical, encrypted origin.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.oracleveil\.online$ [NC]
RewriteRule ^ https://oracleveil.online%{REQUEST_URI} [L,R=301]

Redirect 301 /security.txt /.well-known/security.txt

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; manifest-src 'self'; media-src 'self' https://upload.wikimedia.org; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"

  # The service worker, HTML and manifest must always revalidate so new
  # deploys (and the sw.js cache bump) reach visitors immediately.
  <FilesMatch "(^index\.html$|\.html$|sw\.js$|\.webmanifest$|robots\.txt$|sitemap\.xml$|security\.txt$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Versioned app assets and artwork are immutable.
  <FilesMatch "\.(png|svg|css|ogg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/manifest+json image/svg+xml
</IfModule>
